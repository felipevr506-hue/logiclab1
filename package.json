{
  "name": "logic-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/scan-secrets.ps1",
    "security:deps": "npm audit --audit-level=high",
    "test:security": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-security-tests.ps1",
    "test:e2e": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-e2e.ps1",
    "test:e2e:report": "set \"PLAYWRIGHT_BROWSERS_PATH=%CD%\\.playwright-browsers\" && playwright show-report",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "lucide-react": "1.31.0",
    "monaco-editor": "0.52.2",
    "next": "16.3.1",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "prettier": "3.6.2",
    "prisma": "^7.9.1",
    "tsx": "^4.20.6"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.25.12": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
