# PostgreSQL (necessário ao ativar o adaptador de produção)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logiclab?schema=public"

# Sessões e integrações
APP_ENV="production"
AUTH_MODE="required"
AUTH_EMAIL_DELIVERY="resend"
AUTH_EMAIL_FROM="LogicLab <acesso@example.com>"
RESEND_API_KEY=""
TRUST_PROXY_HEADERS="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_EXECUTION_TIMEOUT_MS="1800"
NEXT_PUBLIC_BROWSER_EXECUTOR_ENABLED="false"

# Billing agnóstico: configure a URL de checkout apenas junto ao adapter e webhook
BILLING_PROVIDER="hotmart"
BILLING_CHECKOUT_URL=""
BILLING_WEBHOOK_SECRET=""
HOTMART_CHECKOUT_URL=""
HOTMART_WEBHOOK_SECRET=""
HOTMART_PRODUCT_ID=""
HOTMART_OFFER_CODE=""
HOTMART_CLIENT_ID=""
HOTMART_CLIENT_SECRET=""
HOTMART_BASIC_TOKEN=""
HOTMART_SANDBOX="false"
KIWIFY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MERCADO_PAGO_ACCESS_TOKEN=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
# Tutor: openai ou openrouter; chaves exclusivamente no servidor.
# OpenRouter gratuito: TUTOR_PROVIDER="openrouter" e TUTOR_MODEL="openrouter/free".
TUTOR_PROVIDER="openai"
TUTOR_MODEL=""
TUTOR_GLOBAL_DAILY_LIMIT="100"

# Operação
MAINTENANCE_MODE="false"
AI_MONTHLY_BUDGET_IN_CENTS="0"
